diff --git a/libgcc/configure b/libgcc/configure
index be5d45f1755..b34defddbfb 100755
--- a/libgcc/configure
+++ b/libgcc/configure
@@ -2386,6 +2386,8 @@ case "${host}" in
 	;;
     i[34567]86-*-mingw* | x86_64-*-mingw*)
 	;;
+    *-*-mint*)
+	;;
     i[34567]86-*-interix[3-9]*)
