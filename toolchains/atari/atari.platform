SET(CMAKE_SYSTEM_NAME FreeMiNT)
SET(CMAKE_SYSTEM_PROCESSOR m68k)
SET(CMAKE_C_COMPILER $ENV{HOST}-gcc)
SET(CMAKE_CXX_COMPILER $ENV{HOST}-g++)
SET(CMAKE_FIND_ROOT_PATH $ENV{PREFIX}/..)
SET(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
SET(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
SET(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
# CMake has no platform module for FreeMiNT, Platform/FreeMiNT.cmake is next to this file
LIST(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})
